# AIFlow-Gateway Environment Configuration
PROJECT_NAME="AIFlow-Gateway"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database (asyncpg)
POSTGRES_USER=aiflow
POSTGRES_PASSWORD=aiflow_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiflow_db
DATABASE_URL="postgresql+asyncpg://aiflow:aiflow_secret@localhost:5432/aiflow_db"

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Distributed Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_SIZE=50

# Security & Master Admin Key
JWT_SECRET_KEY="super-secret-jwt-signing-key-change-in-production"
JWT_ALGORITHM="HS256"
ADMIN_API_KEY="af_master_admin_secret_key_prod_2026"

# Semantic Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Distributed Rate Limiting Defaults
DEFAULT_RATE_LIMIT_RPM=60
RATE_LIMIT_BURST_MULTIPLIER=1.2

# Upstream Mock Configuration
UPSTREAM_TIMEOUT_SECONDS=10.0
UPSTREAM_SIMULATED_LATENCY_MS=250
